CONFIG_IDF_TARGET="esp32p4"

# ESP32-P4X-EYE has an ESP32-P4 chip revision v3.1 or later.
# Do NOT set CONFIG_ESP32P4_SELECTS_REV_LESS_V3 (that is for the older ESP32-P4-EYE).

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The built-in "single app (large)" table doesn't scale to this board's 16MB
# flash and is too small for this binary (camera ISP/BSP/LVGL pulled in) -
# see partitions.csv for the actual layout (4MB app, well within budget).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# PSRAM (camera frame buffers, PNG encoding)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# Camera: OV2710 over MIPI-CSI through the ISP (as in Espressif's P4-EYE BSP example)
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_OV2710=y
CONFIG_CAM_CTRL_SPI_ENABLE=n
# Capture at 1280x720, not the sensor's default 1920x1080 - every preview
# mode (GB Camera, PixelBoy, Digicam) downscales in software every single
# frame, and none of them ever need more than 720p (Digicam's own largest
# preset). Capturing at 1080p meant paying for ~2.25x the source pixels only
# to throw most of them away in that downscale; this is exactly how both
# reference implementations do it too (xiao-pixelcam sets camera_config_t.
# frame_size to a fixed smaller mode at init; the Pi/picamera2 one runs a
# dedicated small "preview" stream, saving full resolution only for the
# still actually being saved) - not a per-frame resolution change, since the
# on-device downscale to whatever exact size/aspect the current mode wants
# still happens the same way it already did.
CONFIG_CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS=y
# CONFIG_CAMERA_OV2710_MIPI_RAW10_1920X1080_25FPS is not set
CONFIG_CAMERA_OV2710_MIPI_DEFAULT_FMT_RAW10_1280X720_25FPS=y

# LVGL is pulled in by the BSP but not used
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

# Long filenames on the SD card (default is 8.3 short names only) - frame/
# ROM/palette filenames dropped onto /FRAMES, /ROMS, /PALETTES are real
# names like "nanner-pancakes.hex", not 8.3-safe. Heap-allocated per lookup
# (simplest option; SPIRAM makes the heap cost a non-issue here).
CONFIG_FATFS_LFN_HEAP=y

# USB Mass Storage (browse SD card photos from a PC over the "USB" port -
# see app_usb.c). Uses the OTG HS controller, a separate PHY from the
# "Debug" port's USB-Serial-JTAG (esp_tinyusb's Kconfig already defaults to
# the HS port on ESP32-P4), so this doesn't disturb flashing/console use.
CONFIG_TINYUSB_MSC_ENABLED=y
# Buffer DMA mode (the default) is back on: it was switched to Slave/IRQ
# mode to save internal-DMA RAM, but the real fix for that turned out to be
# display_hw_esp.c's flags.psram_dma_direct (stopped the display's own SPI
# driver from bounce-copying every frame through that same pool) - Slave
# mode then showed a different problem instead: it couldn't service real
# MSC traffic fast enough, so Windows dropped the connection ~3s after
# enumerating (see app_usb.c's usb_msc_tick()).

# WiFi Gallery (see app_wifi_gallery.h) - the P4 has no radio of its own,
# so WiFi goes through the board's onboard ESP32-C6-MINI-1U over SDIO via
# ESP-Hosted. ESP32P4_EYE_C6_BOARD selects this exact board's SDIO pin
# preset (confirmed against the real schematic - CMD=27, CLK=28, D0-D3=
# 29-32, reset/EN=9 - see app_wifi_gallery.h's comment). The real SD card
# already uses SDMMC slot 0 (app_usb.c's SDMMC_HOST_SLOT_0), so this must
# be slot 1 - the two share the controller but not the slot.
# Do NOT set CONFIG_ESP_WIFI_ENABLED=y here, even though esp_wifi.h's own
# Kconfig-gated buffer options (RX/TX buffer counts etc) don't exist without
# it and esp_hosted-mcu's own host example sets it - on THIS board (SDIO,
# esp_wifi_remote as the actual glue) it backfires: esp_wifi_remote's
# CMakeLists only swaps in its real esp_hosted-backed implementation (and
# the matching injected esp_wifi.h that doesn't need those buffer options)
# when ESP_WIFI_ENABLED is OFF. With it on, the genuine hosted backend
# never gets linked and esp_wifi_init() silently falls back to
# esp_wifi_remote's own weak "unsupported" stub - compiles fine, always
# fails at runtime. Confirmed by the actual boot log: "esp_wifi_remote_weak:
# esp_wifi_remote_init unsupported" right before esp_wifi_init() returns
# ESP_ERR_NOT_SUPPORTED, even with a real, matching-version coprocessor
# already flashed and responding correctly over SDIO.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_HOST_TYPE_MCU=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_EYE_C6_BOARD=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
